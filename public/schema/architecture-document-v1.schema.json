{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bardofcarnac.github.io/Arkour/schema/architecture-document-v1.schema.json",
  "title": "Arkour ArchitectureDocument v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "entry", "nodes", "edges"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "version": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "entry": { "type": "string", "minLength": 1 },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/jsonValue" }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": ["password", "file", "control", "blackIce", "demon", "other"]
        },
        "label": { "type": "string", "minLength": 1 },
        "subtype": { "type": "string", "minLength": 1 },
        "difficulty": { "type": "number" },
        "layout": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "floor": { "type": "integer", "minimum": 1 },
            "column": { "type": "integer" }
          }
        },
        "data": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/jsonValue" }
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "order": { "type": "integer" },
        "default": { "type": "boolean" }
      }
    },
    "jsonValue": {
      "anyOf": [
        { "type": "null" },
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "array", "items": { "$ref": "#/$defs/jsonValue" } },
        { "type": "object", "additionalProperties": { "$ref": "#/$defs/jsonValue" } }
      ]
    }
  }
}
